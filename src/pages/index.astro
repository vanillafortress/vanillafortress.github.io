---
import Layout from "../layouts/default.astro";
import socials from "../data/socials.yaml";
---

<Layout
  title="Vanilla Fortress"
  description="Find and seed vanilla Team Fortress 2 servers running the classic Quickplay ruleset.">

<div class="mid-align">

  <h1>Vanilla Fortress</h1>

  <p>UNDER CONSTRUCTION</p>

  <p>
    Vanilla Fortress is a community hub for finding and seeding vanilla TF2 servers
    reminiscent of the Quickplay era.
  </p>

  <p>Get notifications for sessions on our Discord server and Steam group!</p>

  <img src="/images/vftf/transparent/soldier.png" alt="Soldier">

  <h1>Get Fragging</h1>

  <div class="links">
    <a href={socials.discord}>Discord Server</a>
    <a href={socials.steam}>Steam Group</a>
  </div>

</div>

</Layout>
