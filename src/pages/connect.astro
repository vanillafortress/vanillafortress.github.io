---
import { serverDefinitions } from "../data/servers";
import Layout from "../layouts/default.astro";

const servers = serverDefinitions.flatMap((community) => community.servers);
---

<Layout
  title="Connect"
  description="Easy Connect!"
  noindex>

<section class="page-intro">
  <h1 id="heading">Redirecting</h1>
  <p class="page-lead" id="message">
    You're being redirected right now.
  </p>
  <p class="page-lead" id="fallback">
    If the redirect doesn't work, click this button:
  </p>
  <div class="links" id="links">
    <a id="connect" href="/">Connect</a>
    <button id="command">Copy Connect Command</button>
  </div>
</section>

<script define:vars={{ servers }} is:inline>
  console.log("Connect script loaded");

  async function find_server_by_ip(ip) {
    const server_api = "https://serverbrowser.tf/api/servers?ip=";
    const response = await fetch(`${server_api}${encodeURIComponent(ip)}`);
    console.log("Response:", response)

    if (!response.ok) {
      return null;
    }

    const servers = await response.json();
    console.log("Servers:", servers)

    if (!Array.isArray(servers) || servers.length <= 0) {
      return undefined;
    }

    const server = servers[0];

    return {
      name: server.name,
      ip: server.ip
    };
  }

  async function main() { 
    // Astro wasn't playing nice with top-level awaits in an inline script,
    // so we have to do this. yay.
    console.log("Fetching server_param");
    const server_param = new URLSearchParams(window.location.search).get("server");

    console.log("Fetching server");
    let server = servers.find(
      (server) => server.slug === server_param || server.ip === server_param
    );

    // as Tored said in the Discord:
    // "mayhaps also have a version of the connect link that accepts a raw IP to connect to"
    // "that way it's a universal mechanism"

    if (!server && server_param) {
      console.log("Checking server IP with serverbrowser.tf");
      server = await find_server_by_ip(server_param);
    }

    if (server) {
      console.log("Server found, updating elements");

      const link = `steam://connect/${server.ip}`;
      const command = `connect ${server.ip}`;

      document.title = `Connect to ${server.name}`;

      document.querySelector("#message").textContent =
        `You're being redirected to ${server.name} right now.`;

      document.querySelector("#connect").href = link;
      document.querySelector("#connect").textContent =
        `Connect to ${server.name}`;

      const button = document.querySelector("#command");

      if (button instanceof HTMLButtonElement) {
        button.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(command);

            button.textContent = "Copied!";

            window.setTimeout(() => {
              button.textContent = "Copy Connect Command";
            }, 1000);
          } catch (error) {
            console.error("Could not copy connect command", error);
          }
        });
      }

      console.log("Redirecting");
      window.location.href = link;
    } else {
      console.log("Server not found.");

      document.title = "Server not found!";

      document.querySelector("#heading").textContent
        = "Server not found!";

      document.querySelector("#message").textContent
        = "The server you're trying to connect to doesn't exist.";

      document.querySelector("#fallback").remove();
      document.querySelector("#command").remove();

      const link = document.querySelector("#connect");
      link.href = "/";
      link.textContent = "Return to homepage";
    }
  }

  main();
</script>

</Layout>