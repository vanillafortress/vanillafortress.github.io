---
import "../styles/style.scss";
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import socialLogo from "../assets/vftf/logo.png";
import socials from "../data/socials.yaml";

type Props = {
  title: string;
  description?: string;
  noindex?: boolean;
  connectUrl?: string;
};

const {
  title,
  description = "Search for vanilla Team Fortress 2 servers running the classic Quickplay ruleset.",
  noindex = false,
  connectUrl,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL(socialLogo.src, Astro.site);
const discordEmbed = {
  component: {
    type: 17,
    accent_color: 0xf5722c,
    components: [
      {
        type: 9,
        components: [
          { type: 10, content: `# ${title}\n${description}` },
        ],
        accessory: {
          type: 11,
          media: { url: socialImageUrl.href },
        },
      },
      {
        type: 1,
        components: connectUrl
          ? [
              { type: 2, style: 5, label: "Connect", emoji: { name: "🌐" }, url: connectUrl },
              { type: 2, style: 5, label: "Discord", emoji: { name: "💬" }, url: socials.discord },
            ]
          : [
              { type: 2, style: 5, label: "Discord", emoji: { name: "💬" }, url: socials.discord },
              { type: 2, style: 5, label: "Steam Group", emoji: { name: "🎮" }, url: socials.steam },
            ],
      },
      { type: 10, content: "-# Vanilla Fortress" },
    ],
  },
};
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  url: canonicalUrl,
  description,
  isPartOf: {
    "@type": "WebSite",
    name: "Vanilla Fortress",
    url: Astro.site,
  },
};
---

<!DOCTYPE html>
<html lang="en">

  <head>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="theme-color" content="#292927" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vanilla Fortress" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Vanilla Fortress logo" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Vanilla Fortress logo" />

    <link
      rel="icon"
      type="image/x-icon"
      href="/images/favicon.ico"
    />

    <script
      is:inline
      id="discord:component-embed"
      type="application/json"
      set:html={JSON.stringify(discordEmbed).replace(/</g, "\\u003c")}
    />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

  </head>

  <body>

    <Header />

    <main>
      <slot />
    </main>

    <Footer />

  </body>

</html>
